// Campus Mart — Prisma schema
//
// Phase 0 (foundation): authentication tables required by Better Auth, the
// Campus entity that every campus-scoped record will reference, and the audit
// log. Later phases extend this file (students, vendors, agents, marketplace,
// orders, deliveries, payments).
//
// Conventions
//  - Money is stored as Int in kobo (see lib/money.ts). Never Float/Decimal-as-float.
//  - Every campus-scoped entity carries campusId and is indexed on it.
//  - Uniqueness that protects business rules is enforced at database level.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// A user's active role on the platform. A user has exactly one role; role
/// changes are audited. Authorization is always derived from this server-side
/// value, never from client input.
enum UserRole {
  STUDENT
  VENDOR
  DELIVERY_AGENT
  CAMPUS_ADMIN
  SUPER_ADMIN
}

enum CampusStatus {
  ACTIVE
  INACTIVE
}

/// Verification lifecycle shared by student, vendor and agent onboarding.
enum VerificationStatus {
  /// Profile created but documents not yet submitted.
  INCOMPLETE
  /// Submitted and awaiting Campus Admin review.
  PENDING_VERIFICATION
  /// Admin asked for a correction; the applicant may resubmit.
  CORRECTION_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

/// Private documents uploaded during onboarding (PRD §56). Objects are stored
/// privately and only ever served through authorised, signed access.
enum DocumentType {
  STUDENT_PASSPORT_PHOTO
  STUDENT_ID_CARD
  VENDOR_STOREFRONT
  VENDOR_IDENTITY
  AGENT_STUDENT_ID
  AGENT_FACIAL_VERIFICATION
}

/// Why a product's stock moved (PRD §22). Every movement is recorded, so the
/// current stock level is always explainable from its history.
enum InventoryReason {
  /// Vendor added stock.
  RESTOCK
  /// Vendor corrected the count after a stock take.
  ADJUSTMENT
  /// Reserved or sold through an order (Phase 5).
  SALE
  /// Returned to stock after a cancellation or return (Phase 6/11).
  RETURN
}

/// Lifecycle of a master invoice (PRD §26–28).
///
/// A checkout produces one invoice covering every vendor in the cart. The
/// delivery fee is paid before the delivery is offered to agents (PRD §32), so a
/// freshly placed order starts in AWAITING_DELIVERY_PAYMENT; Phase 8 moves it on
/// when Paystack confirms. Phases 6–8 add the delivery and goods-payment states
/// rather than reusing these.
enum OrderStatus {
  /// Placed, stock reserved, waiting for the student to pay the delivery fee.
  AWAITING_DELIVERY_PAYMENT
  /// Delivery fee settled; the delivery engine may now offer it to agents.
  DELIVERY_PAID
  /// Every vendor order was delivered and paid for.
  COMPLETED
  CANCELLED
}

/// Lifecycle of one vendor's slice of an invoice (PRD §27).
///
/// Each vendor prepares and hands over independently, which is why the split is
/// a row rather than a grouping in the UI. Phase 6 extends this with the
/// assignment and hand-over states; Phase 5 only needs "placed" and "cancelled".
enum VendorOrderStatus {
  /// Awaiting the vendor's acknowledgement; stock is already reserved.
  PLACED
  /// Vendor is assembling the package.
  PREPARING
  /// Package is ready for an agent to collect.
  READY_FOR_PICKUP
  /// An agent has the package and is on the way.
  IN_DELIVERY
  /// Handed to the student and paid for.
  COMPLETED
  CANCELLED
}

/// Lifecycle of one vendor order's delivery (PRD §37).
///
/// A delivery is created when the vendor marks the package ready, but it is only
/// offered to agents once the delivery fee has been paid (PRD §32) — hence the
/// waiting state. AWAITING_OTP, PAYMENT_PENDING and COMPLETED are declared here
/// so the lifecycle is complete in one place; no Phase 6 transition reaches them,
/// they belong to the OTP (Phase 7) and payment (Phase 8) work.
enum DeliveryStatus {
  /// Ready, but the delivery fee is not settled, so the pool must not show it.
  AWAITING_DELIVERY_PAYMENT
  /// In the campus pool, visible to eligible agents.
  AVAILABLE
  /// Claimed by exactly one agent, who now has a pickup deadline.
  ACCEPTED
  /// Collected from the vendor.
  PICKED_UP
  IN_TRANSIT
  /// At the destination, waiting for the student.
  ARRIVED
  /// Phase 7: agent generated an OTP, student must enter it.
  AWAITING_OTP
  /// Phase 8: OTP verified, student owes for the goods.
  PAYMENT_PENDING
  COMPLETED
  /// Student never showed, or payment timed out: goods went back to the vendor.
  RETURNED
  CANCELLED
}

/// One immutable entry in a delivery's history (PRD §42).
///
/// The delivery row carries the current state; this carries how it got there,
/// which is what makes repeated agent cancellations (Rule 27) provable rather
/// than inferred.
enum DeliveryEventType {
  POOLED
  ACCEPTED
  PICKUP_EXPIRED
  AGENT_CANCELLED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  STUDENT_UNAVAILABLE
  /// Phase 7: the student asked for a hand-over code; any previous one died.
  OTP_ISSUED
  /// Phase 7: the agent typed a wrong code. Kept so a pattern is provable.
  OTP_FAILED
  OTP_VERIFIED
  /// Phase 7: the goods-payment window closed unpaid, so the goods went back.
  PAYMENT_TIMED_OUT
  COMPLETED
  RETURNED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Campus (multi-campus from the first migration — PRD Part D)
// ---------------------------------------------------------------------------

model Campus {
  id        String       @id @default(cuid())
  /// Short code, e.g. "ABUAD". Unique platform-wide.
  code      String       @unique
  name      String
  city      String
  state     String?
  country   String       @default("Nigeria")
  status    CampusStatus @default(ACTIVE)
  /// Approximate campus centre, used by the delivery pricing engine.
  latitude  Float?
  longitude Float?
  timezone  String       @default("Africa/Lagos")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  students          StudentProfile[]
  vendors           VendorProfile[]
  registryEntries   StudentRegistryEntry[]
  documents         OnboardingDocument[]
  settings          CampusSettings?
  categories        Category[]
  products          Product[]
  productImages     ProductImage[]
  inventory         InventoryTransaction[]
  deliveryLocations DeliveryLocation[]
  carts             Cart[]
  cartItems         CartItem[]
  orders            Order[]
  vendorOrders      VendorOrder[]
  orderItems        OrderItem[]
  agents            DeliveryAgentProfile[]
  deliveries        Delivery[]
  deliveryEvents    DeliveryEvent[]
  payments          Payment[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  ratings           Rating[]
  disputes          Dispute[]
  refunds           Refund[]

  @@index([status])
}

/// Per-campus operational configuration (PRD §18, §29, §35, §47).
///
/// Every campus has exactly one settings row, created together with the campus
/// so that no code path has to cope with a campus that has no configuration.
/// Money fields are integer kobo (PRD §64); the commission is basis points so
/// that 2.5% is expressible exactly as 250.
model CampusSettings {
  id       String @id @default(cuid())
  campusId String @unique
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// Whether students on this campus may apply to become vendors (PRD §18).
  allowStudentVendors  Boolean @default(false)
  /// Whether a student's matric number must match the imported registry before
  /// an admin can approve them.
  requireRegistryMatch Boolean @default(false)

  // Delivery pricing engine (PRD §29) ------------------------------------
  deliveryBaseFeeKobo    Int @default(20000)
  deliveryPerKmKobo      Int @default(10000)
  deliveryMinimumFeeKobo Int @default(20000)
  deliveryMaximumFeeKobo Int @default(200000)

  /// Platform commission in basis points. 250 = 2.5% (PRD §35).
  commissionBps Int @default(250)

  // Delivery state-machine timers (PRD §41, §44, §47) --------------------
  /// Minutes an agent has to collect a package after accepting it.
  pickupWindowMinutes       Int @default(15)
  /// Minutes an agent waits at the destination for an absent student.
  studentWaitMinutes        Int @default(10)
  /// Minutes a student has to pay for goods after OTP verification.
  goodsPaymentWindowMinutes Int @default(10)

  /// Short notice shown to everyone on the campus. Null when there is none.
  announcement String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Better Auth tables
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Campus Mart additions -----------------------------------------------
  role  UserRole @default(STUDENT)
  phone String?

  /// A user belongs to exactly one campus (Rules 1–4). Super Admins have no
  /// campus and are the only role permitted to query across campuses.
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: Restrict)

  /// Set when an admin suspends the account; suspended users cannot transact.
  suspendedAt     DateTime?
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  auditLogs AuditLog[] @relation("AuditLogActor")

  studentProfile    StudentProfile?        @relation("StudentProfileUser")
  reviewedStudents  StudentProfile[]       @relation("StudentProfileReviewer")
  vendorProfile     VendorProfile?         @relation("VendorProfileUser")
  reviewedVendors   VendorProfile[]        @relation("VendorProfileReviewer")
  uploadedDocuments OnboardingDocument[]   @relation("DocumentUploader")
  importedRegistry  StudentRegistryEntry[] @relation("RegistryImporter")
  inventoryChanges  InventoryTransaction[] @relation("InventoryActor")
  carts             Cart[]                 @relation("CartStudent")
  orders            Order[]                @relation("OrderStudent")
  cancelledOrders   Order[]                @relation("OrderCanceller")
  agentProfile      DeliveryAgentProfile?  @relation("AgentProfileUser")
  reviewedAgents    DeliveryAgentProfile[] @relation("AgentProfileReviewer")
  deliveries        Delivery[]             @relation("DeliveryAgent")
  deliveryEvents    DeliveryEvent[]        @relation("DeliveryEventActor")
  notifications     Notification[]         @relation("NotificationRecipient")
  pushSubscriptions PushSubscription[]     @relation("PushSubscriptionUser")
  ratingsGiven      Rating[]               @relation("RatingRater")
  ratingsModerated  Rating[]               @relation("RatingModerator")
  disputesRaised    Dispute[]              @relation("DisputeRaiser")
  disputesResolved  Dispute[]              @relation("DisputeResolver")

  @@index([campusId, role])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hashed credential password for the email/password provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit log (PRD §65)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String    @id @default(cuid())
  /// Null for system-initiated actions (schedulers, webhooks).
  actorId    String?
  actor      User?     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  UserRole?
  /// Stable action name, e.g. VENDOR_APPROVED, REFUND_INITIATED.
  action     String
  entityType String
  entityId   String?
  campusId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([campusId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Students (PRD §13–16)
// ---------------------------------------------------------------------------

/// A student's campus identity and verification state. The profile is separate
/// from `User` because authentication identity and campus membership have
/// different lifecycles: a user exists as soon as they register, but only an
/// approved profile may transact on a campus.
model StudentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("StudentProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  /// Stored normalised (uppercase, trimmed) so uniqueness cannot be bypassed
  /// with case or spacing variants.
  matricNumber    String
  /// Number printed on the physical ID card, when it differs from the matric
  /// number. Optional, but unique per campus when present.
  studentIdNumber String?

  department String?
  level      String?

  status          VerificationStatus @default(INCOMPLETE)
  /// True when the matric number matched the campus registry at submission.
  registryMatched Boolean            @default(false)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?              @relation("StudentProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Reason shown to the student for a rejection or correction request.
  reviewNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents OnboardingDocument[]

  /// Duplicate-registration protection enforced in the database (PRD §15).
  @@unique([campusId, matricNumber])
  @@unique([campusId, studentIdNumber])
  @@index([campusId, status])
  @@index([status, submittedAt])
}

/// Metadata for a privately stored onboarding document. The file itself lives
/// in object storage; only the key is persisted, and access is always brokered
/// by the server (PRD §56).
model OnboardingDocument {
  id   String       @id @default(cuid())
  type DocumentType

  /// Object key in private storage. Never a public URL.
  storageKey String  @unique
  mimeType   String
  sizeBytes  Int
  /// SHA-256 of the uploaded bytes, used to detect re-uploads of the same file.
  checksum   String?

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([campusId, type])
  @@index([uploadedById])
  @@index([studentProfileId])
  @@index([vendorProfileId])
}

/// Official student list uploaded by a Campus Admin, used to corroborate
/// registrations (PRD §16). A registry entry is not an account.
model StudentRegistryEntry {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  matricNumber String
  name         String
  department   String?
  level        String?

  importedById String?
  importedBy   User?   @relation("RegistryImporter", fields: [importedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, matricNumber])
  @@index([campusId])
}

// ---------------------------------------------------------------------------
// Vendors (PRD §17–19, §23)
// ---------------------------------------------------------------------------

/// An approved seller operating within one campus (Rule 2).
///
/// There is one vendor record per user account (PRD §19): the store, its owner
/// and its manager are not separate accounts. The application and the store are
/// the same row rather than a separate VendorApplication table, because they
/// carry the same fields and splitting them would create two sources of truth
/// for the store's name, location and evidence.
model VendorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("VendorProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  storeName String
  /// URL-safe form of the store name, unique per campus.
  slug      String

  description String?
  /// Contact number shown to admins and, once approved, to delivery agents.
  phone       String

  /// Free-text pickup description, e.g. "Shop 4, Student Centre" (PRD §17).
  storefrontLocation String
  /// Optional coordinates used by the delivery pricing engine (PRD §29).
  latitude           Float?
  longitude          Float?

  status        VerificationStatus @default(INCOMPLETE)
  /// True when the applicant is also a verified student of this campus
  /// (PRD §18). Recorded at submission so a later settings change cannot
  /// retroactively invalidate an approved vendor.
  studentVendor Boolean            @default(false)

  /// Vendor's own kill switch for incoming orders, independent of opening
  /// hours (PRD §23). A store is orderable only when APPROVED, accepting
  /// orders, and inside its opening hours.
  acceptingOrders Boolean @default(false)

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("VendorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Paystack subaccount that receives this store's share of a goods payment
  /// (PRD §34, Phase 8). Null means the vendor has not been onboarded to
  /// Paystack yet, so their share lands in the platform account and is owed as a
  /// manual transfer — recorded on the payment, never assumed.
  paystackSubaccountCode String?

  /// Reason shown to the vendor for a rejection, correction or suspension.
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Rating aggregates (PRD §24, Phase 10).
  ///
  /// Denormalised counters rather than a live AVG(): the marketplace sorts and
  /// filters on them on every browse, and recomputing an average across a
  /// campus's whole rating history for each page would not survive a busy
  /// evening. `ratingSum` is kept alongside the count so the average is always
  /// re-derivable exactly, and `ratingAverageHundredths` exists so "top rated"
  /// can be an indexed sort instead of an in-memory one. All three move in the
  /// same transaction as the rating that changed them.
  ratingCount             Int @default(0)
  /// Sum of every visible score, so the average never drifts from rounding.
  ratingSum               Int @default(0)
  /// Average × 100 (450 = 4.50 stars). Zero when there are no ratings yet.
  ratingAverageHundredths Int @default(0)

  documents      OnboardingDocument[]
  operatingHours VendorOperatingHours[]
  products       Product[]
  inventory      InventoryTransaction[]
  vendorOrders   VendorOrder[]
  ratings        Rating[]

  /// Two stores on the same campus cannot share a name (Rule 2 scoping).
  @@unique([campusId, slug])
  @@index([campusId, status])
  @@index([status, submittedAt])
  /// The "top rated stores" browse order (PRD §24).
  @@index([campusId, status, ratingAverageHundredths])
}

/// One row per weekday per vendor (PRD §23).
///
/// Times are minutes from midnight in the campus timezone rather than DateTime,
/// because a weekly schedule has no date and storing it as a timestamp invites
/// timezone drift. A closed day is a row with isClosed = true, so an absent row
/// means "not configured yet" instead of silently meaning "closed".
model VendorOperatingHours {
  id String @id @default(cuid())

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's Date#getDay.
  dayOfWeek Int
  isClosed  Boolean @default(false)
  /// Minutes from midnight, 0–1439. Null when the day is closed.
  opensAt   Int?
  /// Minutes from midnight, 1–1440 (1440 means midnight at the end of the day).
  closesAt  Int?

  @@unique([vendorProfileId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Marketplace (PRD §20–22, §24, Phase 4)
// ---------------------------------------------------------------------------

/// A product category, owned by a campus and curated by its Campus Admin
/// (PRD §20).
///
/// Categories are per-campus rather than global because campuses sell different
/// things, and a global list would let one campus's taxonomy leak into another's
/// filters. `sortOrder` lets an admin control the browse order without renaming.
model Category {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name String
  /// URL-safe form of the name, unique per campus.
  slug String

  description String?
  sortOrder   Int     @default(0)
  /// Deactivated categories keep their products but disappear from filters.
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([campusId, slug])
  @@index([campusId, isActive])
}

/// Something a vendor sells (PRD §21–22).
///
/// Price is integer kobo (PRD §64) and stock is a plain integer that may never
/// go negative; every change to it is written as an `InventoryTransaction` in
/// the same transaction, so the level is always reconcilable from its history.
///
/// `isAvailable` is the vendor's switch for a product that exists but is not
/// currently on sale. `deletedAt` is a soft delete: a product that has appeared
/// in an order must remain readable for that order's history (Phase 5), so rows
/// are retired rather than removed.
model Product {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  /// Optional so a vendor is never blocked from listing by a missing taxonomy.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name String
  /// URL-safe form of the name, unique per store.
  slug String

  description String?

  /// Unit price in kobo. The server is the only source of price (Rule 1).
  priceKobo Int

  /// Units in stock. Never negative — enforced by a check constraint and by
  /// every write going through the inventory service.
  stockQuantity     Int     @default(0)
  /// At or below this level the vendor is warned that stock is running out.
  lowStockThreshold Int     @default(0)
  /// Free-text unit shown next to the price, e.g. "per plate", "per bottle".
  unitLabel         String?

  /// Vendor's per-product switch. A product is buyable only when available, in
  /// stock, not deleted, and its store is APPROVED and open.
  isAvailable Boolean @default(true)

  /// Units sold, used for the "popular" sort. Ratings arrive in Phase 10.
  soldCount Int @default(0)

  /// Set when the vendor retires the product. Retired products never appear in
  /// the marketplace but remain readable by their vendor and by past orders.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  inventory  InventoryTransaction[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  /// Two products in the same store cannot share a name.
  @@unique([vendorProfileId, slug])
  @@index([campusId, isAvailable])
  @@index([campusId, categoryId])
  @@index([vendorProfileId])
  @@index([campusId, createdAt])
  @@index([campusId, priceKobo])
}

/// A product photograph. The bytes live in private storage and are served by
/// the server (`/api/products/images/[imageId]`), like onboarding documents, so
/// that a campus's catalogue is not published to the open internet.
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// Object key in private storage. Never a public URL.
  storageKey String  @unique
  mimeType   String
  sizeBytes  Int
  checksum   String?
  /// Display order; the lowest position is the product's main image.
  position   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
  @@index([campusId])
}

/// One recorded movement of stock (PRD §22).
///
/// `resultingStock` is stored, not derived, so the ledger can be audited
/// without replaying every row, and a race that produced an impossible level is
/// visible after the fact.
model InventoryTransaction {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  reason         InventoryReason
  /// Signed change: positive adds stock, negative removes it. Never zero.
  delta          Int
  /// Stock level after this movement was applied.
  resultingStock Int

  note String?

  /// Null for system-initiated movements (order expiry, webhooks).
  actorId String?
  actor   User?   @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([campusId, createdAt])
  @@index([vendorProfileId, createdAt])
}

// ---------------------------------------------------------------------------
// Cart, checkout and orders (PRD §25–29, Phase 5)
// ---------------------------------------------------------------------------

/// A place on campus a student may have an order delivered to (PRD §28).
///
/// Curated per campus by its admin rather than free-typed by students, because
/// the delivery fee is computed from the destination's coordinates and an agent
/// has to find it. The student adds the room/flat detail on the order itself.
model DeliveryLocation {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  name String
  /// URL-safe form of the name, unique per campus.
  slug String

  description String?

  /// Used by the delivery pricing engine. Without coordinates the campus
  /// falls back to the base fee alone.
  latitude  Float?
  longitude Float?

  sortOrder Int     @default(0)
  /// Retired locations stay referenced by past orders but cannot be chosen.
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  deliveries Delivery[]

  @@unique([campusId, slug])
  @@index([campusId, isActive])
}

/// A student's open basket on one campus (PRD §25).
///
/// The cart holds no prices. Quantities are the only thing a client may state;
/// every amount is recomputed from `Product` when the cart is read and again at
/// checkout, so a stale or tampered client cannot fix a price (Rule 1).
model Cart {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("CartStudent", fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  /// One cart per student per campus.
  @@unique([studentId, campusId])
  @@index([campusId])
}

/// One product line in a cart. Items from several vendors may sit side by side;
/// the split into vendor orders happens at checkout (PRD §27).
model CartItem {
  id String @id @default(cuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Always positive. Adding the same product again raises this instead of
  /// creating a second row.
  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([campusId])
  @@index([productId])
}

/// The master invoice for one checkout (PRD §26).
///
/// One invoice covers every vendor in the cart and carries the single delivery
/// fee, because the student makes one journey's worth of payment no matter how
/// many stores are involved. All amounts are integer kobo and are computed by
/// the server at checkout; nothing here is ever taken from the client.
model Order {
  id String @id @default(cuid())

  /// Human-readable reference shown to students, vendors and agents.
  reference String @unique

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  studentId String
  student   User   @relation("OrderStudent", fields: [studentId], references: [id], onDelete: Restrict)

  status OrderStatus @default(AWAITING_DELIVERY_PAYMENT)

  /// Restrict, not Cascade: a retired location must not erase an order.
  deliveryLocationId   String
  deliveryLocation     DeliveryLocation @relation(fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  /// Snapshot of the location's name, so renaming it later cannot rewrite an
  /// order the student and agent already agreed on.
  deliveryLocationName String
  /// Room, flat or landmark detail typed by the student.
  deliveryNote         String?
  /// Number the agent calls on arrival.
  contactPhone         String

  /// Straight-line distance used for the fee, in metres. Null when either end
  /// has no coordinates, in which case only the base fee applied.
  distanceMeters Int?

  /// Sum of every vendor order's goods subtotal.
  goodsSubtotalKobo Int
  /// Computed from campus settings and the distance, then clamped to the
  /// campus minimum/maximum. Paid before the delivery is offered (PRD §32).
  deliveryFeeKobo   Int
  /// goodsSubtotalKobo + deliveryFeeKobo, stored so an invoice never has to be
  /// re-derived to be displayed.
  totalKobo         Int

  placedAt DateTime @default(now())

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?     @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorOrders VendorOrder[]
  payments     Payment[]
  disputes     Dispute[]

  @@index([campusId, status])
  @@index([studentId, placedAt])
  @@index([campusId, placedAt])
}

/// One vendor's slice of an invoice (PRD §27).
///
/// Each vendor sees and fulfils only their own slice, and the commission is
/// snapshotted here at checkout so a later change to campus settings cannot
/// alter what an already-placed order owes the platform.
model VendorOrder {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)

  status VendorOrderStatus @default(PLACED)

  /// Sum of this vendor's line totals.
  goodsSubtotalKobo Int
  /// Commission rate in basis points, copied from campus settings at checkout.
  commissionBps     Int
  /// goodsSubtotalKobo × commissionBps ÷ 10 000, rounded half-up in kobo.
  commissionKobo    Int
  /// What the vendor is owed once the goods are paid for (Phase 8 settles it).
  vendorPayoutKobo  Int

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  delivery Delivery?
  disputes Dispute[]

  /// A vendor appears at most once per invoice; a second item from the same
  /// store joins the existing slice.
  @@unique([orderId, vendorProfileId])
  @@index([vendorProfileId, status])
  @@index([campusId, status])
}

/// One purchased line, frozen at checkout (PRD §26).
///
/// The product name, unit price and unit label are snapshots: the vendor may
/// re-price or retire the product afterwards, and none of that may change what
/// this order says was bought and for how much.
model OrderItem {
  id String @id @default(cuid())

  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  /// Restrict: products are soft-deleted precisely so this reference survives.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Snapshots taken at checkout.
  productName   String
  unitLabel     String?
  unitPriceKobo Int

  quantity      Int
  /// unitPriceKobo × quantity, stored so a line total cannot drift.
  lineTotalKobo Int

  createdAt DateTime @default(now())

  @@index([vendorOrderId])
  @@index([productId])
  @@index([campusId])
}

// ---------------------------------------------------------------------------
// Delivery engine (PRD §36–44, Phase 6)
// ---------------------------------------------------------------------------

/// A student cleared to carry deliveries on one campus (PRD §36).
///
/// Separate from `VendorProfile` and `StudentProfile` because agency is a third
/// capability with its own review and its own suspension: a suspended agent is
/// still a student who may keep buying. `cancellationCount` is a counter rather
/// than a derived query so the escalation in Rule 27 can be enforced inside the
/// same transaction that records the cancellation.
model DeliveryAgentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("AgentProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  /// Number an assigned student is given to reach the agent.
  phone String

  status VerificationStatus @default(PENDING_VERIFICATION)

  /// The agent's own switch: off means the pool is not offered to them. An
  /// agent must be APPROVED *and* on duty to receive work (PRD §38).
  isOnDuty Boolean @default(false)

  /// Cancellations after acceptance, and the escalation state they drive
  /// (PRD §42, Rule 27).
  cancellationCount Int       @default(0)
  warnedAt          DateTime?
  underReviewAt     DateTime?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AgentProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Reason shown to the agent for a rejection, correction or suspension.
  reviewNote   String?

  /// Rating aggregates, kept exactly as the vendor's are (Phase 10). An agent's
  /// average is what an admin looks at before acting on a complaint, so it is
  /// maintained in the same transaction as the rating rather than reported by a
  /// nightly job.
  ratingCount             Int @default(0)
  ratingSum               Int @default(0)
  /// Average × 100 (450 = 4.50 stars). Zero until the first rating.
  ratingAverageHundredths Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
  ratings    Rating[]

  @@index([campusId, status])
  @@index([campusId, status, isOnDuty])
  @@index([status, submittedAt])
  @@index([campusId, ratingAverageHundredths])
}

/// The delivery of one vendor's package (PRD §37).
///
/// One per vendor order, not per invoice: each store is a separate pickup, and
/// two stores may be carried by different agents. The row is the state machine —
/// every transition is a named operation that re-reads and asserts the current
/// state, and the deadlines are stored so the server, not a browser timer,
/// decides when a window has closed (PRD §41, §44).
model Delivery {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  /// One delivery per vendor order, enforced by the database so a double
  /// "ready for pickup" cannot put the same package in the pool twice.
  vendorOrderId String      @unique
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  status DeliveryStatus @default(AWAITING_DELIVERY_PAYMENT)

  /// Snapshots of both ends of the journey, so a renamed store or retired
  /// location cannot rewrite a delivery an agent already accepted.
  pickupName      String
  pickupLocation  String
  pickupPhone     String
  destinationName String
  destinationNote String?
  studentPhone    String

  /// The destination that locks an agent while they carry this package
  /// (PRD §43). Restrict, not Cascade: a retired location must not erase a
  /// delivery.
  destinationLocationId String
  destinationLocation   DeliveryLocation @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)

  /// The whole invoice's delivery fee, copied for display alongside the job.
  /// The MVP charges one fee per invoice (PRD §29); how it is shared with the
  /// agent is settled in Phase 8, so nothing here is a payout instruction.
  orderDeliveryFeeKobo Int

  agentProfileId String?
  agentProfile   DeliveryAgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  /// Denormalised for "my deliveries" reads and for audit entries.
  agentUserId    String?
  agent          User?                 @relation("DeliveryAgent", fields: [agentUserId], references: [id], onDelete: SetNull)

  /// Set when the fee is settled and the job enters the pool.
  pooledAt DateTime?

  acceptedAt     DateTime?
  /// acceptedAt + campus pickupWindowMinutes. The server enforces it; the
  /// frontend countdown is decoration (PRD §41).
  pickupDeadline DateTime?

  pickedUpAt  DateTime?
  inTransitAt DateTime?

  arrivedAt    DateTime?
  /// arrivedAt + campus studentWaitMinutes (PRD §44).
  waitDeadline DateTime?

  // Hand-over code (PRD §45–46, Phase 7) ---------------------------------
  /// HMAC of the current code, never the code itself: the plaintext is shown to
  /// the student once, at the moment it is issued, and is not recoverable.
  otpHash       String?
  otpIssuedAt   DateTime?
  /// otpIssuedAt + OTP_VALIDITY_MINUTES (platform policy, see lib/delivery/otp).
  otpExpiresAt  DateTime?
  /// Wrong tries against the current code. Reset when a new code is issued.
  otpAttempts   Int       @default(0)
  /// How many codes this delivery has needed, kept for support and abuse review.
  otpIssueCount Int       @default(0)
  otpVerifiedAt DateTime?

  // Goods payment (PRD §46, Phase 7 sets the window, Phase 8 settles it) --
  /// otpVerifiedAt + campus goodsPaymentWindowMinutes. The server compares it;
  /// letting it pass unpaid returns the goods to the vendor.
  goodsPaymentDeadline DateTime?

  completedAt DateTime?

  returnedAt     DateTime?
  cancelledAt    DateTime?
  /// Why the delivery ended the way it did, shown to student and vendor.
  resolutionNote String?

  /// How many times this package has been offered to the pool. A pickup
  /// expiry or an agent cancellation raises it, which is what makes a
  /// repeatedly abandoned job visible to an admin.
  offerCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   DeliveryEvent[]
  payments Payment[]
  ratings  Rating[]
  disputes Dispute[]

  /// The pool query: available jobs on a campus, optionally narrowed to the

  /// destination an agent is already locked to.
  @@index([campusId, status])
  @@index([campusId, status, destinationLocationId])
  @@index([agentProfileId, status])
  @@index([agentUserId, status])
  @@index([status, pickupDeadline])
  @@index([status, waitDeadline])
  /// The goods-payment timeout sweep (Phase 7).
  @@index([status, goodsPaymentDeadline])
}

/// One immutable entry in a delivery's history (PRD §42).
model DeliveryEvent {
  id String @id @default(cuid())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  type DeliveryEventType

  /// Null for system transitions: expiry sweeps have no human actor.
  actorId   String?
  actor     User?     @relation("DeliveryEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole UserRole?

  note String?

  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
  @@index([campusId, type, createdAt])
}

// ---------------------------------------------------------------------------
// Payments (PRD §30–35, §46–50, Phase 8)
// ---------------------------------------------------------------------------

/// What a payment is for. There are exactly two chargeable events in the MVP,
/// and naming them in an enum is what stops a third from being invented by
/// accident (PRD §32, §46).
enum PaymentPurpose {
  /// Charged on a placed invoice; settling it releases the delivery to the pool.
  DELIVERY_FEE
  /// Charged after a verified hand-over; settling it completes the delivery.
  GOODS
}

/// Lifecycle of one payment attempt.
///
/// PENDING means "we asked Paystack for a checkout", which is not a claim about
/// money. Only a verified provider response moves a row to SUCCESS.
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  /// Initialised, never completed, and superseded by a newer attempt.
  ABANDONED
  /// Some of the money went back, and some of it is still ours to settle.
  ///
  /// Distinct from REFUNDED because "was this paid for?" and "was this fully
  /// unwound?" are different questions: a partially refunded goods payment still
  /// paid for a delivery that really happened.
  PARTIALLY_REFUNDED
  /// The whole amount went back — the goods had already gone home, or a dispute
  /// was upheld in full.
  REFUNDED
}

/// One payment attempt against one order (PRD §33).
///
/// The row is created *before* the student is sent to Paystack, so a payment
/// that vanishes mid-flight is still visible to support. `reference` is ours and
/// unique, which is what makes the webhook idempotent: the provider's callback
/// finds exactly one row, and re-delivering the same callback finds it already
/// settled and does nothing.
///
/// The amounts are copied from the order and the vendor order at initialisation.
/// They are not recomputed when the webhook lands: what the student was asked to
/// pay is what must have arrived, and a mismatch is a refusal rather than a
/// reconciliation (Rule 1).
model Payment {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Set for GOODS payments: the delivery whose hand-over unlocked the charge.
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  purpose PaymentPurpose
  status  PaymentStatus  @default(PENDING)

  /// Our reference, sent to Paystack and echoed back. Unique platform-wide.
  reference String @unique

  /// What the student was asked to pay, in kobo.
  amountKobo           Int
  /// The part that stays with the platform after the split.
  platformKobo         Int
  /// The vendor's share of a goods payment, 0 for a delivery fee.
  vendorPayoutKobo     Int     @default(0)
  /// True when Paystack routed the vendor's share to their subaccount. False
  /// means the platform is holding it and owes a transfer.
  vendorRouted         Boolean @default(false)
  /// Subaccount the split was addressed to, kept for reconciliation.
  vendorSubaccountCode String?

  /// Who started the payment. A plain id, not a relation: `User` already
  /// carries a long list of back-relations, and a payment is always reached
  /// through its order.
  initiatedById String?

  /// Paystack's hosted checkout URL for this attempt.
  authorizationUrl String?

  paidAt        DateTime?
  /// Provider's own words when a payment fails, shown to support, not to users.
  failureReason String?

  /// When the *most recent* refund against this payment succeeded.
  refundedAt         DateTime?
  /// **Cumulative** kobo sent back, across every refund against this payment.
  ///
  /// Cumulative rather than per-refund because the invariant that matters is
  /// "we can never send back more than arrived", and that is a statement about
  /// the total. The individual refunds are rows in `refunds`.
  refundedAmountKobo Int?
  /// The reason for the most recent refund. The full history is in `refunds`.
  refundReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId, purpose, status])
  @@index([deliveryId, status])
  @@index([campusId, status, createdAt])
  @@index([status, createdAt])
}

/// One webhook or verification event, stored before it is acted on (PRD §50).
///
/// `providerEventKey` is the idempotency key. Paystack retries deliveries, and
/// the unique constraint is what makes the second delivery a no-op instead of a
/// second effect: the insert fails, so the handler stops. `processedAt` records
/// that the effect ran, in the same transaction as the effect itself.
model PaymentEvent {
  id String @id @default(cuid())

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// Paystack's event id when present, otherwise `event:reference`.
  providerEventKey String @unique
  eventType        String

  /// The raw body as received, so a disputed settlement can be re-read exactly
  /// as the provider sent it.
  payload Json

  processedAt DateTime?
  /// Why an event was received but deliberately not acted on.
  note        String?

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([eventType, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications and push (PRD §51–55, Phase 9)
// ---------------------------------------------------------------------------

/// What a notification is about.
///
/// An enum rather than a free string: the set of things worth interrupting
/// someone for is a product decision, and naming them here is what stops a
/// twelfth "FYI" from being invented in a route handler. Each value maps to one
/// already-existing named operation (PRD §52).
enum NotificationType {
  /// Vendor: a new order landed in your queue.
  ORDER_PLACED
  /// Student: the vendor accepted and is preparing your order.
  VENDOR_ORDER_PREPARING
  /// Student: your package is ready and waiting for an agent.
  VENDOR_ORDER_READY
  /// Student + vendor: the delivery fee settled, the job is in the pool.
  DELIVERY_POOLED
  /// Agents on duty: a job entered your campus pool.
  DELIVERY_AVAILABLE
  /// Student + vendor: an agent claimed the job.
  DELIVERY_ACCEPTED
  /// Student: the agent has the package.
  DELIVERY_PICKED_UP
  /// Student: the agent is at your destination — the push that matters most.
  DELIVERY_ARRIVED
  /// Student: the hand-over was confirmed, so the goods must now be paid for.
  HANDOVER_VERIFIED
  /// Student: payment landed. Vendor: your sale completed.
  PAYMENT_SETTLED
  /// Student + vendor: the goods went back (unpaid window, or absent student).
  DELIVERY_RETURNED
  /// Student + vendor: the delivery was cancelled or the pickup window lapsed.
  DELIVERY_CANCELLED
  /// Applicant: an admin decided on your student, vendor or agent application.
  APPLICATION_REVIEWED
  /// Vendor + admins: a student opened a case against a purchase.
  DISPUTE_RAISED
  /// Student: an admin picked the case up, so somebody is on it.
  DISPUTE_UPDATED
  /// Student + vendor: the case was closed, with or without money moving.
  DISPUTE_RESOLVED
  /// Student: money is on its way back.
  REFUND_ISSUED
}

/// One in-app notification for one user (PRD §51, §53).
///
/// Campus-scoped like everything else, so a campus's activity cannot be read
/// from another campus's inbox. The row is the record; a push message is a best
/// effort *copy* of it, which is why `pushedAt` is nullable and failure to send
/// is not failure to notify.
///
/// `entityType`/`entityId` and `href` are stored rather than derived: a
/// notification has to survive the thing it points at changing state, and
/// re-deriving a link months later from an enum would be guesswork.
model Notification {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// Who is being told. Cascade: an erased account keeps no inbox.
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  /// Rendered server-side at send time, so a later rename of a store or a
  /// product cannot rewrite what someone was told.
  title String
  body  String

  /// Where the notification takes you. A relative path, never an absolute URL:
  /// the origin belongs to the deployment, not to the row.
  href String?

  /// The thing this is about, for support and for de-duplication by hand.
  entityType String?
  entityId   String?

  readAt DateTime?

  /// When a push copy was successfully handed to a push service. Null means
  /// in-app only — either no subscription, or every send failed.
  pushedAt DateTime?

  createdAt DateTime @default(now())

  /// The inbox query: one user's notifications, newest first.
  @@index([userId, createdAt])
  /// The unread badge.
  @@index([userId, readAt])
  @@index([campusId, createdAt])
  @@index([entityType, entityId])
}

/// One browser or installed PWA that has agreed to receive push (PRD §54).
///
/// Per device, not per user: the same student may have the app on a phone and a
/// laptop, and revoking one must not silence the other. `endpoint` is unique
/// platform-wide because it is the push service's own identifier for that
/// device — re-subscribing with the same endpoint is an update, not a duplicate.
///
/// A push service answering 404/410 means the subscription is dead; the service
/// deletes the row rather than retrying it forever.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation("PushSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalised from the user so a campus-wide fan-out does not have to join.
  /// Null only for a Super Admin, who has no campus.
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// The push service URL for this device.
  endpoint String @unique
  /// Public key of the device's key pair (Web Push `p256dh`).
  p256dh   String
  /// Shared authentication secret (Web Push `auth`).
  auth     String

  /// Only for support: which device stopped receiving pushes.
  userAgent String?

  /// Last time a push was accepted by the service for this device.
  lastUsedAt   DateTime?
  /// Consecutive send failures that were not fatal. A fatal one deletes the row.
  failureCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([campusId])
}

// ---------------------------------------------------------------------------
// Ratings and reviews (PRD §24, §57–59, Phase 10)
// ---------------------------------------------------------------------------

/// Who is being rated.
///
/// One table with a subject discriminator rather than `VendorRating` and
/// `AgentRating`: the rules (one rating per delivery per subject, 1–5, editable
/// for a window, hideable by an admin) are identical, and duplicating them would
/// mean maintaining the same moderation and aggregate logic twice.
enum RatingSubject {
  /// The store that sold the goods.
  VENDOR
  /// The agent who carried them.
  DELIVERY_AGENT
}

/// One student's rating of a store or an agent for one completed delivery
/// (PRD §57).
///
/// The delivery is the unit of experience, not the order: a two-store invoice is
/// two packages, possibly two agents, and one score for the pair would be
/// meaningless. `@@unique([deliveryId, subject])` is what makes "one rating per
/// delivery per subject" a database guarantee rather than an application habit.
///
/// A rating is only accepted after the delivery COMPLETED, because a score given
/// before the goods arrive is not a report of anything. The window for editing it
/// is a policy constant (see lib/ratings/rating-policy), and the row keeps
/// `updatedAt` so an edited rating is visibly an edit.
model Rating {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// The completed delivery being rated. Cascade: a deleted delivery has no
  /// experience left to score.
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  subject RatingSubject

  /// The student who gave it. Cascade with the account: an erased student's
  /// opinion is erased with them, and the aggregates are corrected in the same
  /// transaction by the service that removes it.
  raterId String
  rater   User   @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)

  /// Set when subject = VENDOR. Exactly one of these two is set; the service
  /// enforces the pairing, because a partial unique across two nullable columns
  /// is not expressible here.
  vendorProfileId String?
  vendorProfile   VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  /// Set when subject = DELIVERY_AGENT.
  agentProfileId String?
  agentProfile   DeliveryAgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  /// 1–5 whole stars. Validated at the edge and again in the service.
  score Int

  /// Optional written review. Trimmed and length-capped before it is stored.
  comment String?

  // Moderation (PRD §59) -------------------------------------------------
  /// Set when a Campus Admin hides the rating. A hidden rating still exists —
  /// it is excluded from the aggregates and from public reads, so hiding is
  /// reversible and auditable, unlike deletion.
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenBy     User?     @relation("RatingModerator", fields: [hiddenById], references: [id], onDelete: SetNull)
  /// Why it was hidden, kept for the audit trail rather than for the student.
  hiddenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One score per subject per delivery, enforced by the database.
  @@unique([deliveryId, subject])
  /// A store's or an agent's own reviews, newest first.
  @@index([vendorProfileId, hiddenAt, createdAt])
  @@index([agentProfileId, hiddenAt, createdAt])
  /// The admin moderation queue for a campus.
  @@index([campusId, hiddenAt, createdAt])
  @@index([raterId, createdAt])
}

// ---------------------------------------------------------------------------
// Disputes and refunds (PRD Â§60â€“63, Phase 11)
// ---------------------------------------------------------------------------

/// Why a student is complaining, from a closed list (PRD Â§60).
///
/// A closed list rather than free text alone, because the reason is what a
/// campus will later count: "how often do packages arrive short" is answerable
/// from an enum and unanswerable from a paragraph. `OTHER` exists so an honest
/// complaint that fits nowhere is not forced into the wrong box, and its share of
/// the numbers is the signal that the list needs another entry.
enum DisputeReason {
  /// Marked delivered, but nothing arrived.
  ITEM_NOT_RECEIVED
  /// Something arrived, but not what was bought.
  WRONG_ITEM
  /// Fewer units, or a missing line from the order.
  ITEM_INCOMPLETE
  /// Arrived broken, spoiled or spilled.
  ITEM_DAMAGED
  /// Genuinely the item bought, but not as the listing described it.
  NOT_AS_DESCRIBED
  /// The amount charged does not match the order.
  OVERCHARGED
  /// About the courier's conduct rather than the goods.
  AGENT_CONDUCT
  OTHER
}

/// Where a case is in its life (PRD Â§61).
///
/// There is deliberately no `REJECTED`: a declined complaint is still a
/// *resolved* one â€” it was read, decided and explained. Splitting it out would
/// make "how many cases did we close" depend on who won, which is precisely the
/// number an admin should not be able to flatter.
enum DisputeStatus {
  /// Filed, nobody has picked it up yet.
  OPEN
  /// An admin has taken it and is investigating.
  UNDER_REVIEW
  /// Closed with an outcome. Terminal.
  RESOLVED
  /// The student took it back. Terminal for this case; they may file again while
  /// the window is open, because a withdrawal is often a misunderstanding.
  WITHDRAWN
}

/// What an admin decided (PRD Â§62).
///
/// `NO_REFUND` is an outcome, not the absence of one: a case closed without money
/// moving still owes the student a reason.
enum DisputeResolution {
  /// Everything the student paid for these goods goes back.
  FULL_REFUND
  /// Part of it goes back â€” a short delivery, one damaged item out of four.
  PARTIAL_REFUND
  /// The complaint was not upheld, or was settled without money.
  NO_REFUND
}

/// One student's case against one purchase (PRD Â§60â€“63).
///
/// A dispute hangs off a **`VendorOrder`**, not an `Order`: an invoice can span
/// two stores, and a case against one store is not a case against the other. The
/// `Delivery` is optional because a purchase can go wrong before a delivery
/// exists, and because "what was bought" and "how it travelled" are different
/// subjects.
///
/// The amounts are snapshotted at filing, exactly as Phase 5 snapshots prices:
/// what is at stake in a case must not change because a campus later edited its
/// commission or a vendor edited a product.
model Dispute {
  id String @id @default(cuid())

  /// Human reference, e.g. "DS-7Q4F2K". Quoted in messages and to support, so it
  /// has to be pronounceable â€” a cuid is not.
  reference String @unique

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// The purchase being disputed. One *live* case per purchase, enforced by a
  /// partial unique index created in the migration: two open cases about the
  /// same purchase would let two admins refund it twice.
  vendorOrderId String
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)

  /// The delivery, when there was one. SetNull rather than Restrict: a case
  /// outlives the delivery record it describes.
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  raisedById String
  raisedBy   User   @relation("DisputeRaiser", fields: [raisedById], references: [id], onDelete: Restrict)

  status      DisputeStatus @default(OPEN)
  reason      DisputeReason
  /// The student's account, in their own words.
  description String

  /// What the goods cost, snapshotted at filing. The ceiling on any refund.
  goodsSubtotalKobo Int
  /// The platform's cut of those goods, snapshotted. Used to attribute a refund.
  commissionKobo    Int
  /// The vendor's share of those goods, snapshotted.
  vendorPayoutKobo  Int

  resolution       DisputeResolution?
  /// The admin's explanation. Required when resolving: an unexplained decision is
  /// indistinguishable from an arbitrary one.
  resolutionNote   String?
  /// What was actually sent back, in kobo. 0 for NO_REFUND.
  refundAmountKobo Int?
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?              @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  /// The admin queue for a campus, oldest-first within a status.
  @@index([campusId, status, createdAt])
  @@index([raisedById, createdAt])
  @@index([vendorOrderId, status])
  @@index([status, createdAt])
}

/// One attempt to send money back (PRD Â§63).
///
/// A row per refund rather than three more columns on `Payment`, because a
/// payment can be refunded more than once â€” a case resolved with a partial
/// refund, then escalated â€” and because a refund that fails needs somewhere to
/// say so without erasing the one that succeeded.
///
/// `idempotencyKey` is the safety rail. A dispute resolution keys its refund on
/// the dispute, so a double-clicked "Resolve" hits a unique-constraint violation
/// instead of sending the student's money twice. This is the same trick
/// `Payment.reference` plays for money coming in, for the same reason.
model Refund {
  id String @id @default(cuid())

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// The case that caused it, when a human decided it rather than the system.
  disputeId String?
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  /// Total sent back, in kobo. Never more than the payment captured, less
  /// whatever earlier refunds already returned.
  amountKobo       Int
  /// Attribution of that total (PRD Â§35). The two always sum to `amountKobo`:
  /// money taken out of the vendor's share is money the platform no longer holds
  /// for them, and the distinction is what makes a payout reconcilable.
  fromPlatformKobo Int
  fromVendorKobo   Int

  reason String

  /// Ours, unique platform-wide. See the note above.
  idempotencyKey String @unique

  /// Paystack's id for the refund, kept for reconciliation.
  providerRefundId String?

  /// Set when the provider confirmed it. Null with no `failureReason` means
  /// in-flight: we asked, and do not yet know.
  succeededAt   DateTime?
  failureReason String?

  /// Who decided. Null when the system decided â€” money arriving for goods that
  /// had already gone home.
  initiatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId, createdAt])
  @@index([campusId, createdAt])
  @@index([disputeId])
  @@index([succeededAt, createdAt])
}

// ---------------------------------------------------------------------------
// Abuse controls (Phase 13)
// ---------------------------------------------------------------------------

/// One fixed-window counter for one actor and one action.
///
/// In Postgres rather than in memory, because the platform runs as serverless
/// functions: an in-process `Map` gives each concurrently warm instance its own
/// allowance, so a limit of five becomes five-per-instance — which is no limit at
/// all, and worse, one that looks like it works in development.
///
/// The window index is part of `key` (see `lib/security/rate-limit-policy.ts`), so
/// a new window is a new row instead of a row somebody has to remember to reset.
/// That makes the whole increment a single `INSERT ... ON CONFLICT DO UPDATE SET
/// hits = hits + 1 RETURNING hits`: atomic, one round trip, and correct when two
/// instances race on the same key.
///
/// There is no `campusId` here, deliberately. Everything else on the platform is
/// campus-scoped, but a limiter must be able to count requests from somebody who
/// has not proved which campus they belong to — an unauthenticated sign-in attempt
/// has an IP and nothing else.
model RateLimitCounter {
  /// `ACTION:scope:identifier:windowIndex`.
  key String @id

  /// Attempts counted in this window, including the ones that were refused.
  hits Int @default(1)

  /// End of the window. Only the sweep reads it; the decision itself comes from
  /// the key. Stored so old rows can be deleted by one indexed comparison rather
  /// than by parsing keys.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
