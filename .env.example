# ---------------------------------------------------------------------------
# Campus Mart environment variables
# Copy to .env.local (development) and configure per environment.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------- Database (Neon) ------------------------------
# Pooled connection string used by the application at runtime
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (non-pooled) connection string used by Prisma Migrate
DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------ Better Auth --------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails promoted to Super Admin on sign-in, once their email is
# verified. This is how the platform owner bootstraps — there is no UI for it.
SUPER_ADMIN_EMAILS=owner@example.com


# ------------------------------- Paystack ----------------------------------
# Phase 8. Server-side only; never expose the secret key to the client.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --------------------------- Storage (Cloudflare R2) -----------------------
# Phase 1 (private document uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=campus-mart-documents
R2_PUBLIC_BASE_URL=

# ------------------------------ Web Push -----------------------------------
# Phase 9. npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campusmart.example

# -------------------------------- Maps -------------------------------------
# Phase 5. Abstracted behind MapService; "haversine" needs no provider key.
MAP_PROVIDER=haversine
MAP_PROVIDER_API_KEY=

# ------------------------------ Platform -----------------------------------
# Default platform commission in basis points (250 = 2.5%). Configurable
# per-campus in the database; this is only the fallback default.
DEFAULT_COMMISSION_BPS=250

# Log level: debug | info | warn | error
LOG_LEVEL=debug
