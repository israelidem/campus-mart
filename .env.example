# ---------------------------------------------------------------------------
# Campus Mart environment variables
# Copy to .env.local (development) and configure per environment.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------- Database (Neon) ------------------------------
# Pooled connection string used by the application at runtime
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (non-pooled) connection string used by Prisma Migrate
DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------ Better Auth --------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails promoted to Super Admin on sign-in, once their email is
# verified. This is how the platform owner bootstraps — there is no UI for it.
SUPER_ADMIN_EMAILS=owner@example.com

# ---------------------------- Bootstrap seed -------------------------------
# Read only by `npm run db:seed`, which creates the platform owner's account and
# the first campus. Without this the platform cannot be entered at all: sign-up
# needs a campus, campuses need a Super Admin, and a Super Admin needs a
# verified account. Set a strong password, run the seed once, then remove it.
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Platform Owner
SEED_CAMPUS_CODE=ABUAD
SEED_CAMPUS_NAME=Afe Babalola University, Ado-Ekiti
SEED_CAMPUS_CITY=Ado-Ekiti
SEED_CAMPUS_STATE=Ekiti



# ------------------------------- Paystack ----------------------------------
# Phase 8. Server-side only; never expose the secret key to the client.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ----------------------- Storage (private documents) -----------------------
# Matriculation cards, government ID and vendor business documents. These are
# never publicly addressable: reads go through an API route that authorises the
# viewer first, so no bucket or blob URL is ever handed to a browser.
#
# Leave both of these unset and uploads use the local filesystem (.uploads/),
# which is the right thing for `npm run dev` and needs no account.
#
# On Vercel: add a Blob store to the project and BLOB_READ_WRITE_TOKEN is
# injected automatically — the app then picks the Blob driver on its own, and
# neither variable below needs to be set by hand. The local driver refuses to
# run on Vercel, because the serverless filesystem is read-only and every upload
# would 500.
#
# STORAGE_PROVIDER: "blob" | "local". Only needed to override the inference,
# e.g. forcing "blob" locally to test against a real store.
STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=

# ------------------------------ Web Push -----------------------------------
# Phase 9. npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campusmart.example

# -------------------------------- Maps -------------------------------------
# Phase 5. Abstracted behind MapService; "haversine" needs no provider key.
MAP_PROVIDER=haversine
MAP_PROVIDER_API_KEY=

# ------------------------------ Platform -----------------------------------
# Default platform commission in basis points (250 = 2.5%). Configurable
# per-campus in the database; this is only the fallback default.
DEFAULT_COMMISSION_BPS=250

# Log level: debug | info | warn | error
LOG_LEVEL=debug
